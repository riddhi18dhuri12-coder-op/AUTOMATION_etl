# Copy to .env and fill in real values. Never commit .env to source control.

# Source DB
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# Snowflake destination
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# BigQuery destination (if used instead of/alongside Snowflake)
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# Alerting
ALERT_WEBHOOK_URL=
